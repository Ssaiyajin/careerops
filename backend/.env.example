# CareerOps backend environment
# Copy this file to backend/.env for local use. For deployed environments,
# configure these variables in the hosting provider or backend/.env.

# ── Environment-specific database and authentication ────────────────────
# Development (Render): use the Neon "dev" branch and a unique
# JWT_SECRET_KEY. Production (Render): use the Neon "main" branch and a
# different JWT_SECRET_KEY. Never share these values between environments.
DATABASE_URL=postgresql://<user>:<password>@<dev-or-main-branch-endpoint>.neon.tech/<dbname>?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# ── Application URLs and external services ──────────────────────────────
# Set this to the matching frontend origin outside local development.
APP_BASE_URL=http://localhost:3000

# Optional SMTP settings for password-reset email delivery.
# Example Gmail setup: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USERNAME=you@gmail.com, SMTP_PASSWORD=your_app_password,
# SMTP_FROM_EMAIL=you@gmail.com, SMTP_USE_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Optional processing features ────────────────────────────────────────
# These are disabled by default; enable only where resources allow.
ENABLE_SPACY=false
ENABLE_SEMANTIC_MATCHING=false

# ── Storage and retention ───────────────────────────────────────────────
UPLOAD_DIR=uploads
EXPORT_DIR=exports
MAX_UPLOAD_SIZE_MB=10
RESUME_RETENTION_DAYS=90

# ── Per-account generation and export limits ────────────────────────────
GENERATION_REQUESTS_PER_MINUTE=2
GENERATION_CREDITS_PER_DAY=12
EXPORT_REQUESTS_PER_MINUTE=5
EXPORTS_PER_DAY=30
