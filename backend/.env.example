APP_ENV=dev
ENABLE_SPACY=true
DEV_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/careerops_dev
DEV_JWT_SECRET_KEY=REPLACE_WITH_A_DEV_ONLY_SECRET
DEV_GEMINI_API_KEY=
PROD_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/careerops?sslmode=require
PROD_JWT_SECRET_KEY=REPLACE_WITH_A_PRODUCTION_SECRET
PROD_GEMINI_API_KEY=REPLACE_WITH_A_PRODUCTION_API_KEY
