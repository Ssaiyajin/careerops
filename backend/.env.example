# Postgres connection string. Use a free managed instance (Supabase,
# Neon, OCI Autonomous DB free tier) rather than self-hosting Postgres
# on the same 1GB VM as the app — there isn't RAM to spare for it.
DATABASE_URL=postgresql://user:password@host:5432/careerops

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Both default to disabled — spaCy and sentence-transformers are
# heavy enough that a 1GB box shouldn't load them unless you've
# confirmed there's headroom.
ENABLE_SPACY=false
ENABLE_SEMANTIC_MATCHING=false

UPLOAD_DIR=uploads
EXPORT_DIR=exports
MAX_UPLOAD_SIZE_MB=10
