# OCI (prod environment)
# Copy to backend/.env on the OCI VM.

# Neon "main"/production branch connection string — a DIFFERENT
# connection string than dev. Do not point prod at the dev branch or
# vice versa.
DATABASE_URL=postgresql://<user>:<password>@<main-branch-endpoint>.neon.tech/<dbname>?sslmode=require

# Generate a SEPARATE secret from dev's — tokens issued by dev
# shouldn't be valid against prod and vice versa.
JWT_SECRET_KEY=

GEMINI_API_KEY=

ENABLE_SPACY=false
ENABLE_SEMANTIC_MATCHING=false

UPLOAD_DIR=uploads
EXPORT_DIR=exports
MAX_UPLOAD_SIZE_MB=10
