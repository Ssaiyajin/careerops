# Render (dev environment)
# Copy to .env on the Render backend service.

# Neon "dev" branch connection string — Branches -> dev -> copy connection string
DATABASE_URL=postgresql://<user>:<password>@<dev-branch-endpoint>.neon.tech/<dbname>?sslmode=require

JWT_SECRET_KEY=
GEMINI_API_KEY=

ENABLE_SPACY=false
ENABLE_SEMANTIC_MATCHING=false

UPLOAD_DIR=uploads
EXPORT_DIR=exports
MAX_UPLOAD_SIZE_MB=10
RESUME_RETENTION_DAYS=90

# Per-account limits for generation and document export.
GENERATION_REQUESTS_PER_MINUTE=2
GENERATION_CREDITS_PER_DAY=12
EXPORT_REQUESTS_PER_MINUTE=5
EXPORTS_PER_DAY=30
